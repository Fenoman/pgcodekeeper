# Single source of truth for the pinned pgcodekeeper-core checkout.
#
# Both .github/workflows/pull-request.yml and .github/workflows/release.yml load
# this file into $GITHUB_ENV, and script/verify-eclipse-packaging.py reads it as
# the expected Core identity, so the pin cannot drift between them.
#
# The referenced commit must exist on the remote before a release can run.
PGCK_CORE_REPOSITORY=Fenoman/pgcodekeeper-core
PGCK_CORE_REF=22ea23a44ce140193eb6ce2cac2de167c9854896
