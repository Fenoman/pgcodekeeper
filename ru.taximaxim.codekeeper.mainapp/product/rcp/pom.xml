<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>ru.taximaxim.codeKeeper</artifactId>
        <groupId>ru.taximaxim.codeKeeper</groupId>
        <version>${revision}</version>
        <relativePath>../../../</relativePath>
    </parent>

    <groupId>ru.taximaxim.codeKeeper</groupId>
    <artifactId>ru.taximaxim.codekeeper.rcp.product</artifactId>
    <!-- eclipse-repository versions must be valid OSGi versions. -->
    <version>15.3.0.neo1</version>
    <packaging>eclipse-repository</packaging>

    <repositories>
        <repository>
            <id>eclipse-p2-repo</id>
            <url>https://download.eclipse.org/releases/2026-06</url>
            <layout>p2</layout>
        </repository>
        <repository>
            <id>justj-jre-21</id>
            <url>https://download.eclipse.org/justj/jres/21/updates/release/21.0.11</url>
            <layout>p2</layout>
        </repository>
    </repositories>

    <properties>
        <mac.folder>${project.build.directory}/products/ru.taximaxim.codekeeper.rcp.product/macosx/cocoa</mac.folder>
    </properties>

    <profiles>
        <profile>
            <id>code-sign</id>
            <build>
                <plugins>
                    <plugin>
                        <!-- Signing an application with a key from github actions -->
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>exec</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>codesign</executable>
                                    <arguments>
                                        <argument>--deep</argument>
                                        <argument>--force</argument>
                                        <argument>--verify</argument>
                                        <argument>--verbose=4</argument>
                                        <argument>--sign</argument>
                                        <argument>TAXTELECOM LLC</argument>
                                        <argument>${mac.folder}/aarch64/pgCodeKeeper.app</argument>
                                    </arguments>
                                    <timeout>300000</timeout>
                                </configuration>
                            </execution>
                            <execution>
                                <id>exec2</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>codesign</executable>
                                    <arguments>
                                        <argument>--deep</argument>
                                        <argument>--force</argument>
                                        <argument>--verify</argument>
                                        <argument>--verbose=4</argument>
                                        <argument>--sign</argument>
                                        <argument>TAXTELECOM LLC</argument>
                                        <argument>${mac.folder}/x86_64/pgCodeKeeper.app</argument>
                                    </arguments>
                                    <timeout>300000</timeout>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <!-- Explicit JustJ feature supplies the real Java capabilities. -->
                    <executionEnvironment>none</executionEnvironment>
                    <environments>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <!-- kept in step with the platform of the parent pom: this
                             list is what decides which archives are produced -->
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>aarch64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>aarch64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>x86_64</arch>
                        </environment>
                    </environments>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-p2-director-plugin</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <productRepository>https://download.eclipse.org/justj/jres/21/updates/release/21.0.11</productRepository>
                    <formats>
                        <win32>zip</win32>
                        <linux>tar.gz</linux>
                        <macosx>tar.gz</macosx>
                    </formats>
                    <products>
                        <product>
                            <id>ru.taximaxim.codekeeper.rcp.product</id>
                            <rootFolder>pgcodekeeper</rootFolder>
                            <rootFolders>
                                <macosx>pgCodeKeeper.app</macosx>
                            </rootFolders>
                            <archiveFileName>pgCodeKeeper-${revision}</archiveFileName>
                        </product>
                    </products>
                </configuration>
                <executions>
                    <execution>
                        <id>materialize-products</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>materialize-products</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>archive-products</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>archive-products</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
